---
interface Props {
  size?: string;
  class?: string;
}

const { size = "280", class: className = "" } = Astro.props;
---

<!-- Astronaut Thomas — space suit, helmet visor hint -->
<div class:list={["mascot-float inline-block", className]}>
  <svg width={size} height={size} viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="as-skin" x1="30%" y1="0%" x2="70%" y2="100%">
        <stop offset="0%" stop-color="#5BB8FF" />
        <stop offset="100%" stop-color="#0c87f2" />
      </linearGradient>
      <linearGradient id="as-suit" x1="50%" y1="0%" x2="50%" y2="100%">
        <stop offset="0%" stop-color="#e8edf4" />
        <stop offset="100%" stop-color="#cdd5e0" />
      </linearGradient>
      <linearGradient id="as-boot" x1="50%" y1="0%" x2="50%" y2="100%">
        <stop offset="0%" stop-color="#9aa4b4" />
        <stop offset="100%" stop-color="#7a8494" />
      </linearGradient>
      <radialGradient id="as-bg-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#36a5ff" stop-opacity="0.1" />
        <stop offset="100%" stop-color="#36a5ff" stop-opacity="0" />
      </radialGradient>
    </defs>

    <circle cx="100" cy="100" r="98" fill="url(#as-bg-glow)" />

    <g transform="rotate(2, 100, 100)">
      <!-- HELMET — bigger, rounder, more spacey -->
      <rect x="44" y="-4" width="112" height="80" rx="18" fill="url(#as-suit)" />
      <!-- Visor — dark curved rectangle showing face -->
      <rect x="52" y="8" width="96" height="56" rx="12" fill="url(#as-skin)" />

      <!-- Eyes inside visor -->
      <rect x="71" y="25" width="18" height="18" rx="4" fill="white" />
      <rect x="76" y="29" width="10" height="12" rx="2" fill="#071f3f" />
      <rect x="81" y="29" width="4" height="4" rx="1" fill="white" opacity="0.8" />
      <rect x="111" y="25" width="18" height="18" rx="4" fill="white" />
      <rect x="116" y="29" width="10" height="12" rx="2" fill="#071f3f" />
      <rect x="121" y="29" width="4" height="4" rx="1" fill="white" opacity="0.8" />

      <!-- Smirk -->
      <path d="M88 52 Q94 57 100 57 Q106 57 112 54" stroke="white" stroke-width="2" stroke-linecap="round" fill="none" />

      <!-- Visor reflection -->
      <rect x="58" y="16" width="20" height="6" rx="2" fill="white" opacity="0.12" />

      <!-- NECK — suit collar -->
      <rect x="84" y="72" width="32" height="8" rx="3" fill="url(#as-suit)" />

      <!-- BODY — space suit -->
      <path d="M50 86 Q50 76 58 76 L142 76 Q150 76 150 86 L150 142 Q150 144 148 144 L52 144 Q50 144 50 142 Z" fill="url(#as-suit)" />

      <!-- Chest panel — control unit, bolder -->
      <rect x="80" y="84" width="40" height="28" rx="3" fill="#9aa4b4" opacity="0.5" />
      <rect x="84" y="88" width="10" height="6" rx="1" fill="#0c87f2" opacity="0.7" />
      <rect x="98" y="88" width="10" height="6" rx="1" fill="#e8956a" opacity="0.7" />
      <rect x="84" y="98" width="10" height="6" rx="1" fill="#5BB8FF" opacity="0.6" />
      <rect x="98" y="98" width="10" height="6" rx="1" fill="#5BB8FF" opacity="0.5" />

      <!-- Suit seam lines — bold -->
      <line x1="70" y1="78" x2="70" y2="142" stroke="#8a94a8" stroke-width="1.5" opacity="0.45" />
      <line x1="130" y1="78" x2="130" y2="142" stroke="#8a94a8" stroke-width="1.5" opacity="0.45" />

      <!-- Shoulder seam lines -->
      <line x1="50" y1="84" x2="70" y2="84" stroke="#8a94a8" stroke-width="1.2" opacity="0.4" />
      <line x1="130" y1="84" x2="150" y2="84" stroke="#8a94a8" stroke-width="1.2" opacity="0.4" />

      <!-- American flag — right arm, bigger and bolder -->
      <rect x="132" y="86" width="16" height="12" rx="1" fill="white" opacity="0.5" />
      <!-- Stripes -->
      <line x1="132" y1="89" x2="148" y2="89" stroke="#d04040" stroke-width="1.5" opacity="0.6" />
      <line x1="132" y1="92" x2="148" y2="92" stroke="#d04040" stroke-width="1.5" opacity="0.6" />
      <line x1="132" y1="95" x2="148" y2="95" stroke="#d04040" stroke-width="1.5" opacity="0.6" />
      <!-- Canton -->
      <rect x="132" y="86" width="7" height="6" rx="0.5" fill="#0c87f2" opacity="0.6" />

      <!-- Belt line -->
      <line x1="50" y1="124" x2="150" y2="124" stroke="#a0a8b8" stroke-width="1.5" opacity="0.3" />

      <!-- Suit cuffs — chunky gloves -->
      <rect x="46" y="136" width="24" height="8" rx="2" fill="#cdd5e0" />
      <rect x="130" y="136" width="24" height="8" rx="2" fill="#cdd5e0" />

      <!-- LEGS -->
      <rect x="72" y="144" width="26" height="6" rx="2" fill="url(#as-suit)" />
      <rect x="102" y="144" width="26" height="6" rx="2" fill="url(#as-suit)" />

      <!-- Space boots — chunky -->
      <rect x="66" y="148" width="34" height="10" rx="2" fill="url(#as-boot)" />
      <rect x="100" y="148" width="34" height="10" rx="2" fill="url(#as-boot)" />
      <!-- Boot sole -->
      <rect x="66" y="155" width="34" height="3" rx="1" fill="#6a7484" opacity="0.4" />
      <rect x="100" y="155" width="34" height="3" rx="1" fill="#6a7484" opacity="0.4" />
    </g>

    <!-- Sparkles -->
    <g>
      <path d="M160 0 L162 8 L170 10 L162 12 L160 20 L158 12 L150 10 L158 8 Z" fill="#e8956a" opacity="0.75" />
      <path d="M174 8 L175.5 13 L180 14 L175.5 15 L174 20 L172.5 15 L168 14 L172.5 13 Z" fill="#e8956a" opacity="0.55" />
      <path d="M166 22 L167 25 L170 26 L167 27 L166 30 L165 27 L162 26 L165 25 Z" fill="#e8956a" opacity="0.4" />
    </g>
  </svg>
</div>
