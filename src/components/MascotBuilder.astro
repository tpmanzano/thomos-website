---
interface Props {
  size?: string;
  class?: string;
}

const { size = "280", class: className = "" } = Astro.props;
---

<!--
  ThomOS mascot — "Builder Thom."
  Same character, contractor outfit. No hat.
  Tool belt instead of bow tie. Work shirt instead of tux.
  Rolled-up sleeves. Same face, same smirk, same sparkles.
  "Let's build."
-->
<div class:list={["mascot-float inline-block", className]}>
  <svg width={size} height={size} viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="b-skin" x1="30%" y1="0%" x2="70%" y2="100%">
        <stop offset="0%" stop-color="#5BB8FF" />
        <stop offset="100%" stop-color="#0c87f2" />
      </linearGradient>
      <linearGradient id="b-shirt" x1="50%" y1="0%" x2="50%" y2="100%">
        <stop offset="0%" stop-color="#0a6fd4" />
        <stop offset="100%" stop-color="#0860b8" />
      </linearGradient>
      <linearGradient id="b-boot" x1="50%" y1="0%" x2="50%" y2="100%">
        <stop offset="0%" stop-color="#0860b8" />
        <stop offset="100%" stop-color="#0054a8" />
      </linearGradient>
      <radialGradient id="b-bg-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#36a5ff" stop-opacity="0.1" />
        <stop offset="100%" stop-color="#36a5ff" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- Subtle glow -->
    <circle cx="100" cy="100" r="98" fill="url(#b-bg-glow)" />

    <!-- Tilted 2deg -->
    <g transform="rotate(2, 100, 100)">

      <!-- ===== HEAD — same as consultant ===== -->
      <rect x="50" y="6" width="100" height="68" rx="26" fill="url(#b-skin)" />

      <!-- Eyes -->
      <circle cx="80" cy="34" r="9.5" fill="white" />
      <circle cx="82.5" cy="35" r="5" fill="#071f3f" />
      <circle cx="85" cy="32" r="1.8" fill="white" opacity="0.8" />

      <circle cx="120" cy="34" r="9.5" fill="white" />
      <circle cx="122.5" cy="35" r="5" fill="#071f3f" />
      <circle cx="125" cy="32" r="1.8" fill="white" opacity="0.8" />

      <!-- Same "we know" smirk -->
      <path d="M88 59 Q94 64 100 64 Q106 64 112 61" stroke="white" stroke-width="2" stroke-linecap="round" fill="none" />

      <!-- ===== NECK ===== -->
      <rect x="88" y="70" width="24" height="8" rx="4" fill="url(#b-skin)" />

      <!-- ===== BODY — work shirt, rounded shoulders, flat bottom ===== -->
      <path d="M50 96 Q50 76 72 76 L128 76 Q150 76 150 96 L150 140 Q150 144 146 144 L54 144 Q50 144 50 140 Z" fill="url(#b-shirt)" />

      <!-- ===== WORK SHIRT — crew neck, simple ===== -->
      <!-- Crew collar — filled from neck down to neckline -->
      <path d="M82 76 Q100 94 118 76 L112 70 Q100 70 88 70 Z" fill="#b9dfff" opacity="0.35" />

      <!-- Center seam line — subtle, down the front -->
      <line x1="100" y1="82" x2="100" y2="122" stroke="#5BB8FF" stroke-width="1" opacity="0.15" />

      <!-- Sleeve seam lines -->
      <line x1="70" y1="78" x2="70" y2="142" stroke="#5BB8FF" stroke-width="1" opacity="0.15" />
      <line x1="130" y1="78" x2="130" y2="142" stroke="#5BB8FF" stroke-width="1" opacity="0.15" />

      <!-- Rolled-up sleeve lines — two horizontal lines on each arm -->
      <line x1="50" y1="106" x2="68" y2="106" stroke="#5BB8FF" stroke-width="1.2" opacity="0.25" />
      <line x1="50" y1="110" x2="68" y2="110" stroke="#5BB8FF" stroke-width="1.2" opacity="0.25" />
      <line x1="132" y1="106" x2="150" y2="106" stroke="#5BB8FF" stroke-width="1.2" opacity="0.25" />
      <line x1="132" y1="110" x2="150" y2="110" stroke="#5BB8FF" stroke-width="1.2" opacity="0.25" />

      <!-- ===== TOOL BELT — horizontal band across waist ===== -->
      <rect x="50" y="124" width="100" height="6" rx="2" fill="#0054a8" opacity="0.5" />
      <!-- Belt buckle -->
      <rect x="95" y="123" width="10" height="8" rx="1.5" fill="#5BB8FF" opacity="0.4" />

      <!-- Breast pocket — left side -->
      <rect x="60" y="88" width="10" height="8" rx="1.5" fill="none" stroke="#5BB8FF" stroke-width="1" opacity="0.2" />

      <!-- ===== LEGS — same as consultant ===== -->
      <rect x="72" y="144" width="26" height="10" rx="4" fill="url(#b-shirt)" />
      <rect x="102" y="144" width="26" height="10" rx="4" fill="url(#b-shirt)" />

      <!-- Work boots — chunkier -->
      <rect x="68" y="152" width="32" height="10" rx="4" fill="url(#b-boot)" />
      <rect x="100" y="152" width="32" height="10" rx="4" fill="url(#b-boot)" />
      <!-- Boot sole line -->
      <line x1="70" y1="160" x2="98" y2="160" stroke="#0054a8" stroke-width="1.5" opacity="0.3" />
      <line x1="102" y1="160" x2="130" y2="160" stroke="#0054a8" stroke-width="1.5" opacity="0.3" />

    </g>

    <!-- Thinking sparkles — same as consultant -->
    <g>
      <path d="M160 0 L162 8 L170 10 L162 12 L160 20 L158 12 L150 10 L158 8 Z" fill="#e8956a" opacity="0.75" />
      <path d="M174 8 L175.5 13 L180 14 L175.5 15 L174 20 L172.5 15 L168 14 L172.5 13 Z" fill="#e8956a" opacity="0.55" />
      <path d="M166 22 L167 25 L170 26 L167 27 L166 30 L165 27 L162 26 L165 25 Z" fill="#e8956a" opacity="0.4" />
    </g>
  </svg>
</div>
