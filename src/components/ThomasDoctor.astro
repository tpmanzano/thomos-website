---
interface Props {
  size?: string;
  class?: string;
}

const { size = "280", class: className = "" } = Astro.props;
---

<!-- Doctor Thomas — white coat, stethoscope -->
<div class:list={["mascot-float inline-block", className]}>
  <svg width={size} height={size} viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="d-skin" x1="30%" y1="0%" x2="70%" y2="100%">
        <stop offset="0%" stop-color="#5BB8FF" />
        <stop offset="100%" stop-color="#0c87f2" />
      </linearGradient>
      <linearGradient id="d-coat" x1="50%" y1="0%" x2="50%" y2="100%">
        <stop offset="0%" stop-color="#e8edf4" />
        <stop offset="100%" stop-color="#d0d8e4" />
      </linearGradient>
      <linearGradient id="d-shoe" x1="50%" y1="0%" x2="50%" y2="100%">
        <stop offset="0%" stop-color="#0860b8" />
        <stop offset="100%" stop-color="#0054a8" />
      </linearGradient>
      <radialGradient id="d-bg-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#36a5ff" stop-opacity="0.1" />
        <stop offset="100%" stop-color="#36a5ff" stop-opacity="0" />
      </radialGradient>
    </defs>

    <circle cx="100" cy="100" r="98" fill="url(#d-bg-glow)" />

    <g transform="rotate(2, 100, 100)">
      <!-- HEAD -->
      <rect x="50" y="6" width="100" height="68" rx="10" fill="url(#d-skin)" />

      <!-- Eyes -->
      <rect x="71" y="25" width="18" height="18" rx="4" fill="white" />
      <rect x="76" y="29" width="10" height="12" rx="2" fill="#071f3f" />
      <rect x="81" y="29" width="4" height="4" rx="1" fill="white" opacity="0.8" />
      <rect x="111" y="25" width="18" height="18" rx="4" fill="white" />
      <rect x="116" y="29" width="10" height="12" rx="2" fill="#071f3f" />
      <rect x="121" y="29" width="4" height="4" rx="1" fill="white" opacity="0.8" />

      <!-- Smirk -->
      <path d="M88 59 Q94 64 100 64 Q106 64 112 61" stroke="white" stroke-width="2" stroke-linecap="round" fill="none" />

      <!-- Head mirror — small circle on forehead -->
      <circle cx="100" cy="12" r="5" fill="#d0d8e4" opacity="0.7" />
      <circle cx="100" cy="12" r="3" fill="white" opacity="0.4" />

      <!-- NECK -->
      <rect x="88" y="70" width="24" height="8" rx="3" fill="url(#d-skin)" />

      <!-- BODY — white lab coat -->
      <path d="M50 86 Q50 76 58 76 L142 76 Q150 76 150 86 L150 142 Q150 144 148 144 L52 144 Q50 144 50 142 Z" fill="url(#d-coat)" />

      <!-- Scrubs/shirt underneath — blue V -->
      <polygon points="90,76 100,100 110,76" fill="#0c87f2" opacity="0.5" />

      <!-- Coat lapel lines — darker, more visible -->
      <line x1="90" y1="76" x2="84" y2="110" stroke="#8a94a8" stroke-width="1.5" opacity="0.55" />
      <line x1="110" y1="76" x2="116" y2="110" stroke="#8a94a8" stroke-width="1.5" opacity="0.55" />

      <!-- Sleeve seams — darker -->
      <line x1="70" y1="78" x2="70" y2="142" stroke="#8a94a8" stroke-width="1.2" opacity="0.4" />
      <line x1="130" y1="78" x2="130" y2="142" stroke="#8a94a8" stroke-width="1.2" opacity="0.4" />

      <!-- Stethoscope — bigger, bolder -->
      <path d="M86 78 Q86 112 100 118 Q114 112 114 78" stroke="#0c87f2" stroke-width="3" fill="none" opacity="0.6" />
      <circle cx="100" cy="120" r="5" fill="#0c87f2" opacity="0.6" />

      <!-- Coat pocket -->
      <rect x="58" y="96" width="10" height="12" rx="1" fill="none" stroke="#b0bac8" stroke-width="1" opacity="0.3" />
      <!-- Pen in pocket -->
      <rect x="62" y="92" width="2" height="8" rx="0.5" fill="#0c87f2" opacity="0.4" />

      <!-- Coat button -->
      <rect x="98" y="120" width="4" height="4" rx="1" fill="#b0bac8" opacity="0.35" />

      <!-- Cuffs — white coat cuffs -->
      <rect x="48" y="137" width="22" height="5" rx="1" fill="white" opacity="0.35" />
      <rect x="130" y="137" width="22" height="5" rx="1" fill="white" opacity="0.35" />

      <!-- LEGS -->
      <rect x="72" y="144" width="26" height="6" rx="2" fill="#0a6fd4" />
      <rect x="102" y="144" width="26" height="6" rx="2" fill="#0a6fd4" />

      <!-- Shoes -->
      <rect x="68" y="148" width="32" height="9" rx="1" fill="url(#d-shoe)" />
      <rect x="100" y="148" width="32" height="9" rx="1" fill="url(#d-shoe)" />
    </g>

    <!-- Sparkles -->
    <g>
      <path d="M160 0 L162 8 L170 10 L162 12 L160 20 L158 12 L150 10 L158 8 Z" fill="#e8956a" opacity="0.75" />
      <path d="M174 8 L175.5 13 L180 14 L175.5 15 L174 20 L172.5 15 L168 14 L172.5 13 Z" fill="#e8956a" opacity="0.55" />
      <path d="M166 22 L167 25 L170 26 L167 27 L166 30 L165 27 L162 26 L165 25 Z" fill="#e8956a" opacity="0.4" />
    </g>
  </svg>
</div>
