---
interface Props {
  size?: string;
  class?: string;
}

const { size = "280", class: className = "" } = Astro.props;
---

<!--
  ThomOS mascot — "Atari Thom."
  Same proportions as Consultant Thom, just squared off.
  Tighter corner radii, more geometric. Retro pixel feel without being pixel art.
  Same face, same smirk, same sparkles.
-->
<div class:list={["mascot-float inline-block", className]}>
  <svg width={size} height={size} viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="a-skin" x1="30%" y1="0%" x2="70%" y2="100%">
        <stop offset="0%" stop-color="#5BB8FF" />
        <stop offset="100%" stop-color="#0c87f2" />
      </linearGradient>
      <linearGradient id="a-tux" x1="50%" y1="0%" x2="50%" y2="100%">
        <stop offset="0%" stop-color="#0a6fd4" />
        <stop offset="100%" stop-color="#0860b8" />
      </linearGradient>
      <linearGradient id="a-shoe" x1="50%" y1="0%" x2="50%" y2="100%">
        <stop offset="0%" stop-color="#0860b8" />
        <stop offset="100%" stop-color="#0054a8" />
      </linearGradient>
      <radialGradient id="a-bg-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#36a5ff" stop-opacity="0.1" />
        <stop offset="100%" stop-color="#36a5ff" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- Subtle glow -->
    <circle cx="100" cy="100" r="98" fill="url(#a-bg-glow)" />

    <!-- Tilted 2deg -->
    <g transform="rotate(2, 100, 100)">

      <!-- ===== HEAD — squared off, tight radius ===== -->
      <rect x="50" y="6" width="100" height="68" rx="10" fill="url(#a-skin)" />

      <!-- Eyes — same but slightly more rectangular -->
      <rect x="71" y="25" width="18" height="18" rx="4" fill="white" />
      <rect x="76" y="29" width="10" height="12" rx="2" fill="#071f3f" />
      <rect x="81" y="29" width="4" height="4" rx="1" fill="white" opacity="0.8" />

      <rect x="111" y="25" width="18" height="18" rx="4" fill="white" />
      <rect x="116" y="29" width="10" height="12" rx="2" fill="#071f3f" />
      <rect x="121" y="29" width="4" height="4" rx="1" fill="white" opacity="0.8" />

      <!-- The "we know" smirk — same curve -->
      <path d="M88 59 Q94 64 100 64 Q106 64 112 61" stroke="white" stroke-width="2" stroke-linecap="round" fill="none" />

      <!-- ===== NECK ===== -->
      <rect x="88" y="70" width="24" height="8" rx="3" fill="url(#a-skin)" />

      <!-- ===== BODY — squared off shoulders ===== -->
      <path d="M50 86 Q50 76 58 76 L142 76 Q150 76 150 86 L150 142 Q150 144 148 144 L52 144 Q50 144 50 142 Z" fill="url(#a-tux)" />

      <!-- ===== SHIRT — same as consultant ===== -->
      <polygon points="93,76 100,114 107,76" fill="#b9dfff" opacity="0.45" />

      <!-- Bow tie -->
      <polygon points="94,82 97,78 97,86" fill="#5BB8FF" />
      <polygon points="106,82 103,78 103,86" fill="#5BB8FF" />
      <rect x="97" y="80" width="6" height="4" rx="1" fill="#7cc4ff" />

      <!-- Lapel lines -->
      <line x1="93" y1="76" x2="86" y2="110" stroke="#5BB8FF" stroke-width="1.2" opacity="0.25" />
      <line x1="107" y1="76" x2="114" y2="110" stroke="#5BB8FF" stroke-width="1.2" opacity="0.25" />

      <!-- Sleeve seam lines -->
      <line x1="70" y1="78" x2="70" y2="142" stroke="#5BB8FF" stroke-width="1" opacity="0.15" />
      <line x1="130" y1="78" x2="130" y2="142" stroke="#5BB8FF" stroke-width="1" opacity="0.15" />

      <!-- Button -->
      <rect x="98" y="120" width="4" height="4" rx="1" fill="#5BB8FF" opacity="0.3" />

      <!-- Pocket square -->
      <rect x="60" y="96" width="7" height="2" rx="0.5" fill="#5BB8FF" opacity="0.25" />

      <!-- ===== SHIRT CUFFS ===== -->
      <rect x="48" y="137" width="22" height="5" rx="1" fill="#b9dfff" opacity="0.45" />
      <rect x="130" y="137" width="22" height="5" rx="1" fill="#b9dfff" opacity="0.45" />

      <!-- ===== LEGS — shorter ===== -->
      <rect x="72" y="144" width="26" height="6" rx="2" fill="url(#a-tux)" />
      <rect x="102" y="144" width="26" height="6" rx="2" fill="url(#a-tux)" />

      <!-- Shoes — squared off, just a hint of rounding -->
      <rect x="68" y="148" width="32" height="9" rx="1" fill="url(#a-shoe)" />
      <rect x="100" y="148" width="32" height="9" rx="1" fill="url(#a-shoe)" />

    </g>

    <!-- Thinking sparkles -->
    <g>
      <path d="M160 0 L162 8 L170 10 L162 12 L160 20 L158 12 L150 10 L158 8 Z" fill="#e8956a" opacity="0.75" />
      <path d="M174 8 L175.5 13 L180 14 L175.5 15 L174 20 L172.5 15 L168 14 L172.5 13 Z" fill="#e8956a" opacity="0.55" />
      <path d="M166 22 L167 25 L170 26 L167 27 L166 30 L165 27 L162 26 L165 25 Z" fill="#e8956a" opacity="0.4" />
    </g>
  </svg>
</div>
