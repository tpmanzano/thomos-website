---
interface Props {
  size?: string;
  class?: string;
}

const { size = "280", class: className = "" } = Astro.props;
---

<!-- Firefighter Thomas — helmet, turnout coat, reflective stripes -->
<div class:list={["mascot-float inline-block", className]}>
  <svg width={size} height={size} viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="ff-skin" x1="30%" y1="0%" x2="70%" y2="100%">
        <stop offset="0%" stop-color="#5BB8FF" />
        <stop offset="100%" stop-color="#0c87f2" />
      </linearGradient>
      <linearGradient id="ff-coat" x1="50%" y1="0%" x2="50%" y2="100%">
        <stop offset="0%" stop-color="#d03030" />
        <stop offset="100%" stop-color="#b02020" />
      </linearGradient>
      <linearGradient id="ff-boot" x1="50%" y1="0%" x2="50%" y2="100%">
        <stop offset="0%" stop-color="#2a2a2a" />
        <stop offset="100%" stop-color="#1a1a1a" />
      </linearGradient>
      <radialGradient id="ff-bg-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#36a5ff" stop-opacity="0.1" />
        <stop offset="100%" stop-color="#36a5ff" stop-opacity="0" />
      </radialGradient>
    </defs>

    <circle cx="100" cy="100" r="98" fill="url(#ff-bg-glow)" />

    <g transform="rotate(2, 100, 100)">
      <!-- FIRE HELMET — rounded dome top, flat brim -->
      <!-- Dome — big rounded top -->
      <ellipse cx="100" cy="2" rx="56" ry="22" fill="#d03030" />
      <!-- Lower helmet body connecting dome to brim -->
      <rect x="48" y="0" width="104" height="18" rx="4" fill="#d03030" />
      <!-- Helmet front shield — bigger -->
      <rect x="80" y="2" width="40" height="16" rx="3" fill="#b02020" />
      <!-- Shield emblem -->
      <rect x="88" y="5" width="24" height="9" rx="1.5" fill="#e8956a" opacity="0.55" />
      <!-- Brim — flat, wide -->
      <rect x="40" y="16" width="120" height="6" rx="2" fill="#b02020" />

      <!-- HEAD -->
      <rect x="50" y="18" width="100" height="56" rx="10" fill="url(#ff-skin)" />

      <!-- Eyes -->
      <rect x="71" y="28" width="18" height="18" rx="4" fill="white" />
      <rect x="76" y="32" width="10" height="12" rx="2" fill="#071f3f" />
      <rect x="81" y="32" width="4" height="4" rx="1" fill="white" opacity="0.8" />
      <rect x="111" y="28" width="18" height="18" rx="4" fill="white" />
      <rect x="116" y="32" width="10" height="12" rx="2" fill="#071f3f" />
      <rect x="121" y="32" width="4" height="4" rx="1" fill="white" opacity="0.8" />

      <!-- Smirk -->
      <path d="M88 59 Q94 64 100 64 Q106 64 112 61" stroke="white" stroke-width="2" stroke-linecap="round" fill="none" />

      <!-- NECK -->
      <rect x="88" y="70" width="24" height="8" rx="3" fill="url(#ff-skin)" />

      <!-- BODY — turnout coat (tan/yellow) -->
      <path d="M50 88 Q50 78 58 78 L142 78 Q150 78 150 88 L150 142 Q150 144 148 144 L52 144 Q50 144 50 142 Z" fill="url(#ff-coat)" />

      <!-- Reflective stripes — two horizontal bands -->
      <rect x="50" y="104" width="100" height="4" rx="1" fill="#e8e4a0" opacity="0.5" />
      <rect x="50" y="118" width="100" height="4" rx="1" fill="#e8e4a0" opacity="0.5" />

      <!-- Firefighter badge — left chest -->
      <path d="M60 90 L68 84 L76 90 L74 100 L62 100 Z" fill="#e8956a" opacity="0.55" />
      <circle cx="68" cy="94" r="2" fill="#c4783a" opacity="0.4" />

      <!-- Coat center closure -->
      <line x1="100" y1="78" x2="100" y2="142" stroke="#8a1818" stroke-width="1.5" opacity="0.3" />

      <!-- Sleeve seams -->
      <line x1="70" y1="80" x2="70" y2="142" stroke="#8a1818" stroke-width="1" opacity="0.25" />
      <line x1="130" y1="80" x2="130" y2="142" stroke="#8a1818" stroke-width="1" opacity="0.25" />

      <!-- Sleeve reflective bands -->
      <rect x="50" y="130" width="20" height="3" rx="1" fill="#e8e4a0" opacity="0.4" />
      <rect x="130" y="130" width="20" height="3" rx="1" fill="#e8e4a0" opacity="0.4" />

      <!-- Cuffs — reflective -->
      <rect x="48" y="137" width="22" height="5" rx="1" fill="#e8e4a0" opacity="0.35" />
      <rect x="130" y="137" width="22" height="5" rx="1" fill="#e8e4a0" opacity="0.35" />

      <!-- LEGS — dark turnout pants, lighter so visible -->
      <rect x="72" y="144" width="26" height="6" rx="2" fill="#5a4a3a" />
      <rect x="102" y="144" width="26" height="6" rx="2" fill="#5a4a3a" />

      <!-- Boots — dark but visible -->
      <rect x="68" y="148" width="32" height="9" rx="1" fill="#3a3a3a" />
      <rect x="100" y="148" width="32" height="9" rx="1" fill="#3a3a3a" />
      <!-- Boot highlight so they show -->
      <rect x="70" y="150" width="12" height="2" rx="0.5" fill="#5a5a5a" opacity="0.3" />
      <rect x="102" y="150" width="12" height="2" rx="0.5" fill="#5a5a5a" opacity="0.3" />
    </g>

    <!-- Sparkles -->
    <g>
      <path d="M160 0 L162 8 L170 10 L162 12 L160 20 L158 12 L150 10 L158 8 Z" fill="#e8956a" opacity="0.75" />
      <path d="M174 8 L175.5 13 L180 14 L175.5 15 L174 20 L172.5 15 L168 14 L172.5 13 Z" fill="#e8956a" opacity="0.55" />
      <path d="M166 22 L167 25 L170 26 L167 27 L166 30 L165 27 L162 26 L165 25 Z" fill="#e8956a" opacity="0.4" />
    </g>
  </svg>
</div>
